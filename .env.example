# ------------------------
# Frontend (Vite)
# ------------------------
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id

# Supabase (auth + public profiles + file storage)
VITE_SUPABASE_URL=https://nwdrhowksvblkuvqhmlu.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ------------------------
# Go Backend
# ------------------------
# Neon PostgreSQL (preferred)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# or individual vars:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=neondb

JWT_SECRET=change-me-in-production
PORT=5000
CORS_ORIGIN=*

# Supabase Storage (for Go backend file uploads - optional)
SUPABASE_URL=https://nwdrhowksvblkuvqhmlu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=eduroute-files

# ------------------------
# Netlify Function: send-email
# ------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM=EduRoute <you@gmail.com>

# ------------------------
# Buddy AI + Live Web Search
# ------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
