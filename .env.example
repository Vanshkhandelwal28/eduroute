# ------------------------
# Frontend (Vite)
# ------------------------
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id

# Supabase (auth + public profiles) — required for production signup/login + /u/:username
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase (optional)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ------------------------
# Netlify Function: send-email
# ------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM=EduRoute <you@gmail.com>
CORS_ORIGIN=https://your-production-domain.com

# ------------------------
# Buddy AI + Live Web Search (Netlify Functions)
# ------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=eduroute
